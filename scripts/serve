#!/usr/bin/env bash
# Запуск сайта встроенным сервером PHP.
#
#   ./scripts/serve            — 127.0.0.1:8090
#   PORT=9000 ./scripts/serve  — другой порт
set -euo pipefail
cd "$(dirname "$0")/.."

HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-8090}"

exec php \
	-d extension="$PWD/tools/php-ext/pdo_sqlite.so" \
	-d extension="$PWD/tools/php-ext/sqlite3.so" \
	-S "$HOST:$PORT" \
	-t public \
	scripts/router.php
